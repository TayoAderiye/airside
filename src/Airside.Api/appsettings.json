{
  "Airside": {
    "Store": {
      "Provider": "Postgres",
      "ConnectionString": "Host=airside-db;Database=airside;Username=airside;Password=",
      "KeyRingPath": "/var/lib/airside/keys"
    },
    "Docker": {
      "SocketUri": "unix:///var/run/docker.sock",
      "ApiVersion": ""
    },
    "Proxy": {
      "AdminAddress": "http://airside-proxy:2019",
      "ServerName": "airside",
      "AcmeEmail": ""
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
