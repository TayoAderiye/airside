<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>airside-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      So the tests can map an endpoint group and inspect what came out of it.
      Route configuration is otherwise untestable from outside: whether a route
      requires authentication is metadata attached at Map time, not a property of
      any type the test assembly can reach.
    -->
    <InternalsVisibleTo Include="Airside.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airside.Core\Airside.Core.csproj" />
    <ProjectReference Include="..\Airside.Data\Airside.Data.csproj" />
    <ProjectReference Include="..\Airside.Data.Migrations.Postgres\Airside.Data.Migrations.Postgres.csproj" />
    <ProjectReference Include="..\Airside.Data.Migrations.Sqlite\Airside.Data.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\Airside.Runtime\Airside.Runtime.csproj" />
  </ItemGroup>

</Project>
