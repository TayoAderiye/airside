<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Postgres migrations and nothing else. This project exists because EF Core
    emits provider-specific DDL and permits exactly one DbContextModelSnapshot
    per assembly, so two providers cannot share one migrations project. It is an
    EF Core constraint, not a design preference. See ARCHITECTURE.md §1.
  -->

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Airside.Data\Airside.Data.csproj" />
  </ItemGroup>

</Project>
