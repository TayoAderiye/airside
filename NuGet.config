<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Sources are cleared and pinned to nuget.org.

    Two reasons this file exists rather than inheriting the machine's config:
    a public project must build identically for a contributor who has never
    heard of any private feed; and an unpinned source list is the setup that
    makes dependency-confusion attacks work, where a private package name
    published to a public feed gets resolved instead of the intended one.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
