<Project>

  <!-- Shared build settings for every project. See CONVENTIONS.md §1. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning that is allowed to persist is a warning nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!--
      Pinned to a version, not "latest". With TreatWarningsAsErrors on,
      "latest-recommended" means the rule set moves with whatever SDK feature band
      the machine happens to have — so CI on 10.0.400 failed on CA1873 while a
      contributor on 10.0.100 could not reproduce it, because the rule did not
      exist there.

      Pinning this is the whole fix; global.json deliberately still rolls forward
      by feature band, because the SDK container image and a contributor's machine
      will not be on the same one and requiring that broke the Docker build.

      This is the same reason Airside refuses a floating image tag: a version that
      moves on its own turns a routine build into an unplanned upgrade. Raising
      this number is a deliberate act, and whatever new rules appear get fixed
      then.
    -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>

    <!-- Airside runs in a Linux container with a fixed locale. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      One place. The API reports this, the installer pins it, and the updater
      rewrites the image tag that carries it — a version that disagrees with the
      tag is how a rollback targets the wrong build.
    -->
    <VersionPrefix>0.1.6</VersionPrefix>

    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
