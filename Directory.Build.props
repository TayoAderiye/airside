<Project>

  <!-- Shared build settings for every project. See CONVENTIONS.md §1. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning that is allowed to persist is a warning nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Airside runs in a Linux container with a fixed locale. -->
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      One place. The API reports this, the installer pins it, and the updater
      rewrites the image tag that carries it — a version that disagrees with the
      tag is how a rollback targets the wrong build.
    -->
    <VersionPrefix>0.1.0</VersionPrefix>

    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
