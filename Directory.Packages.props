<Project>

  <!--
    Central package management. Package versions live here and nowhere else;
    individual .csproj files carry <PackageReference Include="..." /> with no
    Version attribute. See CONVENTIONS.md §1.

    Packages are added as the phase that needs them lands, not up front.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Runtime">
    <!--
      Docker.DotNet's newest release is 3.125.15 (2021). It is still the only
      maintained typed client, and Docker's Engine API is backward compatible, so
      a 2021 client works against a current daemon for the endpoints it knows.
      Airside sends no explicit API version by default so the daemon picks its
      own: a fixed pin cannot span Docker 20.10 (max 1.41) and Docker 29
      (min 1.44). The runtime layer is the only place affected if the library
      ever needs replacing.
    -->
    <PackageVersion Include="Docker.DotNet" Version="3.125.15" />

    <!--
      Git cloning in-process. The alternatives were worse: shelling out to git
      violates the no-host-commands rule and would put git in the API image, and
      cloning inside a helper container means extracting a whole tree back out
      through the archive API. LibGit2Sharp is a managed API over libgit2 with no
      shell anywhere in it.
    -->
    <PackageVersion Include="LibGit2Sharp" Version="0.32.0" />

    <!--
      DNS lookups against a chosen resolver. The framework's Dns class cannot do
      either thing pre-flight needs: it always uses the host's own resolver — the
      one machine most likely to answer differently from the public internet — and
      it cannot read CAA records at all, which decide whether Let's Encrypt is
      permitted to issue for a name in the first place.
    -->
    <PackageVersion Include="DnsClient" Version="1.8.0" />

    <!--
      SMTP for notification email. System.Net.Mail.SmtpClient is documented by
      Microsoft as unsuitable for new development — it predates modern TLS
      negotiation and has no support for OAuth or for STARTTLS on the ports
      providers actually use. MailKit is the alternative Microsoft's own
      documentation points at, and email delivery is not somewhere to hand-roll a
      protocol client.
    -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

</Project>
