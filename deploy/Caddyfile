# Bootstrap Caddy configuration.
#
# Airside drives Caddy through its admin API at airside-proxy:2019 and rewrites
# routes at runtime; this file only establishes the admin listener and a default
# response, so a request arriving before any domain is attached gets an
# explanation rather than a connection reset.

{
	# Bound to all interfaces so airside-api can reach it over airside-internal —
	# "localhost:2019" would mean the proxy's own loopback, which the API cannot
	# see. The port is never published to the host, and origins are restricted,
	# because this API is unauthenticated and can load configuration that
	# executes commands.
	admin 0.0.0.0:2019 {
		origins airside-proxy:2019 airside-api
	}

	# Airside decides what is logged; Caddy's own access log stays terse.
	log {
		output stdout
		format json
		level WARN
	}
}

:80 {
	respond "Airside is running. No domain is attached to this address yet." 200
}
